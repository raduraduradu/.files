@define-color primary #dfcdcd;
/*@define-color primary #dfcdcd;*/
* {
  border: none;
  border-radius: 0;
  min-height: 0;
  font-family: "otf-font-awesome";
  font-size: 12px;
  padding: 0;
}



window#waybar {
  background-color: rgba(10, 10, 10, 0.8);
  color: @primary;
}

tooltip {
  background-color: #202020;
}

#clock,
#tray,
#cpu,
#memory,
#battery,
#network,
#pulseaudio,
#nightshield {
  margin: 0px 0px;
  padding: 4px 4px;
}

#nightshield{
	margin: 0px 20px;
}

#workspaces button {
  color: @primary;
  padding: 0px 0px;
}


#workspaces button.focused {
  background-color: @primary;
  color: #202020;
}

#workspaces button.active {
  background-color: #202020;
  color: @primary;
}

#battery, #tray, #clock, #cpu, #pulseaudio, #memory {
  /* background-color: none; */
  color: @primary;
}

